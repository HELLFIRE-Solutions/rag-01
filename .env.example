POSTGRES_DB=hellfire_rag
POSTGRES_USER=hellfire
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5433

# Used by rag/cli.py; point at the local docker-compose db for dev, or the
# shared HELLFIRE Postgres instance (rag schema) once deployed.
RAG_DATABASE_URL=postgresql://hellfire:changeme@localhost:5433/hellfire_rag

# Only needed if using rag.embeddings.MistralEmbedder instead of the default
# local embedder.
MISTRAL_API_KEY=

# Only needed for rag/generation.py (answer synthesis over retrieved chunks).
ANTHROPIC_API_KEY=

# Scoped least-privilege app role (migrations/0002_scoped_app_role.sql) --
# only used by scripts/set-rag-app-password.sh, never read by any migrate
# script. Not the same secret as POSTGRES_PASSWORD (that's the superuser).
# Lives in the same shared Postgres instance as internal-db, so on the
# deployed server this is set in internal-db's own .env, not a separate
# one here -- see internal-db's CRM_APP_PASSWORD/MARKETING_APP_PASSWORD
# for the established convention.
RAG_APP_PASSWORD=changeme
